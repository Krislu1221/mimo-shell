# Copy to .env for local overrides. Never commit the real .env.

# Where `mimo serve` listens (start.sh / desktop shell)
MIMO_PORT=4096

# Optional: Coding Plan / platform key (prefer macOS Keychain service
# `mimo-coding-plan` — the desktop shell reads it automatically)
# MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Optional: override engine binary path
# MIMO_BIN=~/.mimocode/bin/mimo

# Optional: default workdir for the desktop shell
# MIMO_WORKDIR=

# Optional: native title bar instead of integrated hiddenInset window
# MIMO_TITLEBAR=default
